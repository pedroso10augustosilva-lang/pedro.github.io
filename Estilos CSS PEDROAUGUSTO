</html>


Arquivo estilos.css


* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  line-height: 1.6;
  background-color: #f4f4f4;
  color: #333;
}

.cabecalho {
  background-color: #00008B;
  color: white;
  text-align: center;
  padding: 30px;
}

.conteudo {
  max-width: 800px;
  margin: 20px auto;
  padding: 20px;
  background-color: white;
  border-radius: 8px;
}

.destaque {
  background-color: #00008B;
  padding: 10px;
  border-left: 4px solid #f39c12;
}

.cartoes {
  display: flex;
  gap: 15px;
  margin-top: 20px;
}

.cartao {
  flex: 1;
  background-color: ##FFFFFF;
  color: white;
  padding: 20px;
  text-align: center;
  border-radius: 6px;
}
