<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>SEJA UM ALFA</title>
  <link rel="stylesheet" href="estilos.css">
</head>
<body>
  <header class="cabecalho">
    <h1>Bem-vindo ao CSS</h1>
  </header>

  <main class="conteudo">
    <p class="destaque">NAO ACEITE OPINIOES DE BETAS</p>
    <p>IREI TE MOSTRAT COMO</p>

    <div class="cartoes">
      <div class="cartao">Cartão 1</div>
      <div class="cartao">Cartão 2</div>
      <div class="cartao">Cartão 3</div>
      <div class="cartao">Cartão 4</div>
    </div>
  </main>
